# Private rooms (players on their own phones) use Supabase Realtime.
# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings > API (or the "Connect" dialog).
# Both values are public by design and are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
